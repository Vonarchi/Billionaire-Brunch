# Supabase project URL and publishable key.
# Found in the Supabase dashboard under Project Settings → API.
# Do not put the service role or secret key in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Used for canonical links. On Vercel this falls back to the deployment host.
# NEXT_PUBLIC_SITE_URL=https://billionairebrunch.example
